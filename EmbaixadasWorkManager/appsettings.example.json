{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "EmbaixadasWorkManager": "Debug"
    }
  },
  "AWS": {
    "Profile": "default",
    "Region": "sa-east-1"
  },
  "SQS": {
    "QueueNameExecucao": "your-execucao-queue-name",
    "QueueNameProcesso": "your-processo-queue-name",
    "MaxNumberOfMessages": 10,
    "WaitTimeSeconds": 20,
    "VisibilityTimeoutSeconds": 60
  },
  "DynamoDB": {
    "TableNameExecucao": "Execucao",
    "TableNameVerificacao": "Verificacao",
    "TableNameConsulta": "Consulta",
    "TableNameParametro": "Parametro",
    "TableNameExecucaoVerificacao": "ExecucaoVerificacao",
    "TableNameExecucaoProcesso": "ExecucaoProcesso",
    "TableNameExecucaoResumoView": "ExecucaoResumoView",
    "TableNameExecucaoEmpresaStatus": "ExecucaoEmpresaStatus",
    "TableNameResultado": "Resultado",
    "TableNameResultadoAgregado": "ResultadoAgregado",
    "ServiceUrl": "",
    "UseLocalStack": false
  },
  "Processamento": {
    "BuscarTodasVerificacoesSeVazio": false
  },
  "PostProcessing": {
    "Enabled": true,
    "Agrupamento": {
      "Enabled": false,
      "Order": 1,
      "TimeoutSeconds": 60,
      "BatchSize": 25
    },
    "ExclusaoRegistros": {
      "Enabled": false,
      "Order": 2,
      "TimeoutSeconds": 60,
      "TabelasParaExcluir": []
    },
    "AgregacaoResultados": {
      "Enabled": true,
      "Order": 3,
      "TimeoutSeconds": 120,
      "BatchSize": 25
    }
  }
}

